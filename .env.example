# ATS-SMT Pro Trading Bot Configuration

# Trading Mode: paper, testnet, live
TRADING_MODE=paper

# Exchanges to connect (comma-separated)
EXCHANGES=binance,okx,bybit,mexc,htx,bingx,bitget,gateio,kucoin,kraken

# Symbols to trade (canonical format)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ENA/USDT,ART/USDT,ADA/USDT,TRX/USDT,DOGE/USDT,SUI/USDT

# Timeframes
TIMEFRAME=30m
HTF1=4h
HTF2=1d

# Risk Management
RISK_PCT=1.0
MAX_OPEN_TRADES=3
MAX_DAILY_DRAWDOWN=5.0
MAX_POSITION_EXPOSURE=20.0
MAX_SYMBOL_EXPOSURE=10.0
MAX_TOTAL_EXPOSURE=50.0

# Strategy Parameters
STRUCTURE_PERIOD=20
ADX_PERIOD=14
ADX_DEAD=15
ADX_RANGE=25
ADX_TREND=25
ADX_VOTE=20
VOLUME_SMA=20
VOLUME_MULT=1.5
ATR_PERIOD=14
MIN_ATR_PCT=0.3
MAX_BOS_DIST_ATR=0.5
COOLDOWN_BARS=6
IMPULSE_MULT=1.0
BB_PERIOD=20
BB_STDDEV=2.0
BB_LOOKBACK=10
MAX_BOUNCES=2

# Take Profit / Stop Loss
TP1_PCT=40
TP2_PCT=30
TP3_PCT=30
USE_BREAKEVEN=true
USE_TRAILING=false
TRAILING_OFFSET=0.25

# Filter Mode: 2of3, ALL
FILTER_MODE=2of3

# Auto Start
AUTO_START_ENGINE=false
LIVE_TRADING_ENABLED=false
TESTNET_TRADING_ENABLED=true

# Database
DATABASE_URL=postgresql://ats_smt_user:ats_smt_pass@localhost:5432/ats_smt_db

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# API Keys (per exchange)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_TESTNET=true

HTX_API_KEY=
HTX_API_SECRET=
HTX_TESTNET=true

BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_TESTNET=true

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_TESTNET=true

GATEIO_API_KEY=
GATEIO_API_SECRET=
GATEIO_TESTNET=true

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
KUCOIN_TESTNET=true

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_TESTNET=false

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/workspace/logs/ats_smt.log
