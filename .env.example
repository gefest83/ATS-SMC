# Application
DEBUG=false
LOG_LEVEL=INFO

# Infrastructure
DATABASE_URL=postgresql+asyncpg://ats:ats_secret@postgres:5432/ats

# Trading
TRADING_MODE=paper          # paper | testnet | live
EXCHANGE=binance            # binance | bybit | okx | bitget | mexc | kucoin | gateio
EXCHANGE_MODE=testnet       # testnet | live
SYMBOL=BTC/USDT
TIMEFRAME=15m
INITIAL_EQUITY=10000
AUTO_START_ENGINE=false
LIVE_TRADING_ENABLED=false
TESTNET_TRADING_ENABLED=false

# Risk
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_OPEN_TRADES=3
MIN_RR_RATIO=2.0

# Exchange credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
GATEIO_API_KEY=
GATEIO_API_SECRET=

# Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API security (required for live trading; recommended for testnet control)
API_AUTH_ENABLED=false
API_ACCESS_TOKEN=
